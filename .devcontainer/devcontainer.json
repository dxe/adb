// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
  "name": "DxE ADB",

  // https://code.visualstudio.com/docs/devcontainers/create-dev-container#_use-docker-compose
  "dockerComposeFile": [
    "../server/compose.yaml",
    "./compose.extend.yaml",
    "./compose.workspace.yaml"
  ],
  "service": "devcontainer", // defined in dockerComposeFile
  "runServices": ["devcontainer", "mysql"], // defined in dockerComposeFile
  // Linked worktrees break if VS Code remounts the shared Git root at /workspace.
  "mountWorkspaceGitRoot": false,
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  // Keep mise's installed tools in a named volume (mounted below) so rebuilds
  // and other worktrees reuse them instead of re-downloading everything.
  // Generated with `mise generate devcontainer --mount-mise-data`.
  "containerEnv": {
    "MISE_DATA_DIR": "/mnt/mise-data"
  },
  // Put mise's shims on PATH for everything VS Code launches (Go extension,
  // Delve, debug sessions), which doesn't run through an activated shell. Each
  // shim runs its tool via mise, so versions and [env] from mise.toml apply.
  // The mise binary itself comes from the mise feature (/usr/local/bin).
  // ~/.local/bin holds Claude Code, installed by on-create.sh.
  "remoteEnv": {
    "PATH": "/mnt/mise-data/shims:/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  // Generate a per-worktree Compose override for the project name and mounts.
  "initializeCommand": "bash .devcontainer/write-workspace-compose.sh '${localWorkspaceFolder}'",

  // Features to add to the dev container. More info: https://containers.dev/features.
  "features": {
    "ghcr.io/devcontainers-extra/features/mise:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true,
      "azureDnsAutoDetection": true,
      "installDockerBuildx": true,
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    },
    // Go, golangci-lint, Delve, Node, pnpm, Python and the mysql client are
    // installed by mise (see mise.toml) in on-create.sh.
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      // bash-completion is useful for entering git commands in the devcontainer
      //     and our .bashrc requires this.
      // gnupg2 enables gpg signing of git commits:
      //     https://code.visualstudio.com/remote/advancedcontainers/sharing-git-credentials#_sharing-gpg-keys
      // build-essential provides make (used by jobs/Makefile) and lets
      //     node-gyp build native npm modules.
      "packages": "bash-completion,gnupg2,build-essential"
    },
    "ghcr.io/devcontainers/features/aws-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        // Bake the worktree folder name into the window title so two devcontainer
        // windows are distinguishable. ${localWorkspaceFolderBasename} is a
        // devcontainer variable substituted at container-create time with the
        // literal folder name; the rest are VS Code window.title variables
        // evaluated at runtime.
        "window.title": "${localWorkspaceFolderBasename} — ${activeEditorShort}${separator}${appName}"
      },
      "extensions": [
        "ms-vscode.makefile-tools",
        "golang.go",
        "GitHub.vscode-github-actions",
        "ms-vscode.vscode-typescript-next",
        "esbenp.prettier-vscode",
        "GitHub.vscode-pull-request-github",
        "vitest.explorer",
        "hverlin.mise-vscode"
      ]
    }
  },

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  "forwardPorts": [8080 /* ADB main site (adb.dxe.io) */],

  // Configure tool-specific properties.
  // "customizations": {},

  // onCreateCommand (not postCreateCommand) so the tools are installed before
  // VS Code extensions (e.g. the Go extension) start looking for them.
  "onCreateCommand": "bash /workspace/.devcontainer/on-create.sh",

  // Persist Claude Code config (settings, credentials) across container rebuilds.
  // Using ${devcontainerId} in the volume name scopes it to this project — each
  // project gets its own isolated volume rather than sharing one across all devcontainers
  // on the same Docker host.
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    // Shared across projects and worktrees on purpose: it's only a cache of
    // tool installs, keyed by tool and version.
    "source=mise-data-volume,target=/mnt/mise-data,type=volume"
  ]
}
