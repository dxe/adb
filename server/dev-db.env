# Local development MySQL credentials. These match server/scripts/init.sql
# (loaded by server/compose.yaml). Plain KEY=VALUE so it can be used by mise,
# shell `source`, docker `--env-file`, Compose `env_file`, and VS Code envFile.
# DB_PROTOCOL/DB_HOST are not here: they depend on where the code runs.
# mise.toml's [env] provides these same values (plus a 127.0.0.1 host and
# protocol) as defaults for mise tasks; keep in sync.
DB_USER=adb_user
DB_PASSWORD=adbpassword
DB_NAME=adb_db
